#!/usr/bin/env python3
"""edge-heartbeat — autonomous beat launcher (ADR-0003).

Runs the beat as a single-shot `claude -p -` fed the /ed-beat skill body. No cognition here,
no envelope, no retry — cognition lives in the skill. Interactive dispatch does not use this:
the live session runs /ed-beat in-place (never spawns claude -p).
"""
import argparse
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _beat


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--home", required=True)
    ap.add_argument("--dry-run", action="store_true", help="Print the command and prompt; do not invoke claude")
    args = ap.parse_args()

    home = Path(os.path.expanduser(args.home))
    prompt = _beat.load_beat_prompt(home)
    try:
        claude_bin = _beat.resolve_claude_bin()
    except FileNotFoundError:
        if not args.dry_run:
            raise
        claude_bin = "claude"
    cmd = _beat.build_beat_command(claude_bin)

    if args.dry_run:
        print(" ".join(cmd))
        print("--- prompt ---")
        print(prompt)
        return
    sys.exit(subprocess.run(cmd, cwd=str(home), input=prompt, text=True,
                            env=_beat.build_beat_env(home)).returncode)


if __name__ == "__main__":
    main()
