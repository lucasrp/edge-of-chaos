#!/usr/bin/env python3
"""edge-heartbeat — autonomous beat launcher (ADR-0003).

Runs the beat as a single-shot `claude -p -` fed the /ed-beat skill body. No cognition here,
no envelope, no retry — cognition lives in the skill. Interactive dispatch does not use this:
the live session runs /ed-beat in-place (never spawns claude -p).
"""
import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _beat


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--home", required=True)
    ap.add_argument("--group", default=None,
                    help="Override the graph group for the cortex door (else identity resolves it)")
    ap.add_argument("--dispatch-id", default=None,
                    help="Stable plan id for an idempotent retry (default: mint one invocation id)")
    ap.add_argument("--dry-run", action="store_true", help="Print the command and prompt; do not invoke claude")
    args = ap.parse_args()

    home = Path(os.path.expanduser(args.home))
    prompt = _beat.load_beat_prompt(home)
    try:
        claude_bin = _beat.resolve_claude_bin()
    except FileNotFoundError:
        if not args.dry_run:
            raise
        claude_bin = "claude"
    # Slice 6 (F1) — register the standing cortex read door on the lead beat. Best-effort: if the
    # config can't be generated (no identity, etc.), the beat still launches without the door (the
    # door darkens, never blocks the beat — ADR-0011). The delta subagent denies it via disallowed-tools.
    try:
        mcp_config_path = _beat.ensure_cortex_config(home, group=args.group)
    except Exception as e:  # noqa: BLE001 — a missing door never blocks the beat
        print(f"edge-heartbeat: cortex door not registered ({type(e).__name__}: {e}) — "
              f"the beat runs without mid-turn recall; recall still seeds at wake", file=sys.stderr)
        mcp_config_path = None
    cmd = _beat.build_beat_command(claude_bin, mcp_config_path=mcp_config_path)

    if args.dry_run:
        print(" ".join(cmd))
        print("--- prompt ---")
        print(prompt)
        return

    # A32: decide BEFORE Claude starts. The same dispatch id is an idempotency key: retrying cannot
    # consume another rotation slot. The plan is injected in BOTH prompt and env, so the skill begins
    # from a mechanically-authoritative producer/tool/permission decision rather than deciding from
    # portfolio-bearing grounding. Map state is absent from runtime_dispatch_inputs/dispatch_plan.
    dispatch_id = args.dispatch_id or _beat.mint_plan_dispatch_id()
    voz, session, contract = _beat.runtime_dispatch_inputs(home, dispatch_id)
    plan = _beat.dispatch_plan(
        voz, session, contract, "lead", dispatch_id,
        state_path=home / "state" / "beat" / "cursor.json",
        runtime_command=cmd,
    )
    prompt = _beat.bind_dispatch_plan(prompt, plan)
    child_env = _beat.build_beat_env(home)
    child_env["EDGE_DISPATCH_PLAN"] = json.dumps(plan, ensure_ascii=False, sort_keys=True)
    child_env["EDGE_DISPATCH_PLAN_ID"] = dispatch_id

    # Serialize the WHOLE critical section {capture before_count -> run claude -p -> assert} under an
    # exclusive flock (Codex gate round-4 [medium]): otherwise two overlapping heartbeats share a
    # before/after window and one can produce NOTHING yet pass because the other appended a kerneled
    # Artefato inside its window. Holding the lock for the full window makes a corpus increase
    # attributable to the invocation that produced it. The dry-run path returns above — it stays
    # lock-free (no beat runs).
    import eventlog
    log = home / "state" / "events" / "log.jsonl"
    with _beat.heartbeat_lock(home):
        # Capture the corpus count BEFORE the beat (Codex gate finding [high]): the post-dispatch gate
        # needs a baseline to prove stage-(iii) produced a NEW kerneled Artefato. The beat writes to
        # the install's own log (state/events/log.jsonl under home == the install).
        before_count = len(eventlog.corpus_at(log=log))

        rc = subprocess.run(cmd, cwd=str(home), input=prompt, text=True,
                            env=child_env).returncode
        if rc != 0:
            sys.exit(rc)  # claude -p itself failed — keep the existing failure exit.

        # claude -p exited 0, but a 0 only proves the subprocess ran. Fold the log and assert real
        # work: a beat that 'succeeded' without publishing a new kerneled Artefato (or that left C3
        # debt) is a FAILED beat — exit nonzero so the heartbeat surfaces it.
        gaps = _beat.assert_beat_produced(
            log, before_count, expected_producer=plan["decision"]["producer"])
    if gaps:
        for gap in gaps:
            print(f"edge-heartbeat: beat exited 0 but produced no corpus progress: {gap}",
                  file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
