_CLAUDE_FAMILY = frozenset({"claude", "opus", "fable"})
_ALL_CLIS = tuple(sorted(_beat.FIXED_HEARTBEAT_CLIS | {"random"}))
DEFAULT_TIMEOUT_SECONDS = 30 * 60
MAX_TIMEOUT_SECONDS = DEFAULT_TIMEOUT_SECONDS
MAX_LOCAL_CONTINUATIONS = 1
PROCESS_GROUP_TERM_GRACE_SECONDS = 2.0
PROCESS_GROUP_KILL_GRACE_SECONDS = 5.0
RUNTIME_POLL_SECONDS = 0.25


class RuntimeRiteTerminal(RuntimeError):
    """The agent's matching rite reached an unrecoverable terminal failure."""


class RuntimeDetachedChildren(RuntimeError):
    """The runtime returned while processes it spawned were still alive."""


class _HeartbeatBudget:
    """One monotonic timeout budget shared by every act and local continuation."""

    def __init__(self, timeout_seconds, *, clock=None):
        self.timeout_seconds = timeout_seconds
        self._clock = clock or time.monotonic
        self.started = self._clock()

    def remaining(self):
        return self.timeout_seconds - (self._clock() - self.started)


PR_SET_CHILD_SUBREAPER = 36
PR_GET_CHILD_SUBREAPER = 37


def _set_child_subreaper(enabled):
    """Set Linux child-subreaper state and return its previous value."""
    libc = ctypes.CDLL(None, use_errno=True)
    previous = ctypes.c_int()
    if libc.prctl(PR_GET_CHILD_SUBREAPER, ctypes.byref(previous), 0, 0, 0) != 0:
        err = ctypes.get_errno()
        raise OSError(err, os.strerror(err))
    if libc.prctl(PR_SET_CHILD_SUBREAPER, int(bool(enabled)), 0, 0, 0) != 0:
        err = ctypes.get_errno()
        raise OSError(err, os.strerror(err))
    return bool(previous.value)


def _direct_children(parent_pid):
    """Read direct Linux children from /proc without invoking a mutable external tool."""
    children = set()
    for stat_path in Path("/proc").glob("[0-9]*/stat"):
        try:
            raw = stat_path.read_text(encoding="utf-8")
            tail = raw.rsplit(") ", 1)[1].split()
            if int(tail[1]) == parent_pid:  # tail: state, ppid, pgrp, session, ...
                children.add(int(stat_path.parent.name))
        except (FileNotFoundError, IndexError, ValueError, OSError):
            continue
    return children


def _descendant_tree(roots):
    found = set(roots)
    frontier = set(roots)
    while frontier:
        new = set()
        for pid in frontier:
            new.update(_direct_children(pid))
        new -= found
        found.update(new)
        frontier = new
    return found


def _signal_pids(pids, sig):
    for pid in sorted(set(pids), reverse=True):
        try:
            os.kill(pid, sig)
        except ProcessLookupError:
            pass


def _reap_known_children(pids):
    for pid in set(pids):
        try:
            os.waitpid(pid, os.WNOHANG)
        except (ChildProcessError, ProcessLookupError):
            pass


def _process_state(pid):
    """Return the Linux /proc state letter, or None when the process vanished."""
    try:
        raw = (Path("/proc") / str(pid) / "stat").read_text(encoding="utf-8")
        return raw.rsplit(") ", 1)[1].split()[0]
    except (FileNotFoundError, IndexError, OSError):
        return None


def _reap_exited_adopted_children(baseline_children):
    """Collect adopted zombies without treating an already-dead helper as an escape.

    A live adopted process is still handled fail-closed by
    ``_cleanup_adopted_runtime_children``.  Codex legitimately leaves short-lived helper
    processes already exited (state Z) for its temporary subreaper to collect.
    """
    owner = os.getpid()
    roots = _direct_children(owner) - set(baseline_children)
    exited = {pid for pid in roots if _process_state(pid) == "Z"}
    _reap_known_children(exited)
    return sorted(exited)


def _cleanup_adopted_runtime_children(baseline_children):
    """Kill only new direct children adopted by this temporary subreaper."""
    owner = os.getpid()
    roots = _direct_children(owner) - set(baseline_children)
    if not roots:
        return []
    observed = _descendant_tree(roots)
    _signal_pids(observed, signal.SIGTERM)
    deadline = time.monotonic() + PROCESS_GROUP_TERM_GRACE_SECONDS
    while time.monotonic() < deadline:
        _reap_known_children(observed)
        roots = _direct_children(owner) - set(baseline_children)
        if not roots:
            return sorted(observed)
        observed.update(_descendant_tree(roots))
        time.sleep(0.02)
    _signal_pids(observed, signal.SIGKILL)
    deadline = time.monotonic() + PROCESS_GROUP_KILL_GRACE_SECONDS
    while time.monotonic() < deadline:
        _reap_known_children(observed)
        roots = _direct_children(owner) - set(baseline_children)
        if not roots:
            return sorted(observed)
        observed.update(_descendant_tree(roots))
        _signal_pids(roots, signal.SIGKILL)
        time.sleep(0.02)
    raise RuntimeError(
        f"heartbeat could not reap adopted runtime children: {sorted(roots)}"
    )


def _process_group_exists(pgid):
    """True while any process still belongs to the launcher's isolated POSIX group."""
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _wait_process_group_gone(pgid, timeout_seconds):
    deadline = time.monotonic() + timeout_seconds
    while _process_group_exists(pgid) and time.monotonic() < deadline:
        time.sleep(0.02)
    return not _process_group_exists(pgid)


def _terminate_process_group(process, baseline_children=None):
    """Terminate and prove the complete runtime tree dead before terminalizing its dispatch."""
    pgid = process.pid  # start_new_session=True makes the child PID its process-group ID.
    adopted = []
    try:
        os.killpg(pgid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    try:
        process.wait(timeout=PROCESS_GROUP_TERM_GRACE_SECONDS)
    except subprocess.TimeoutExpired:
        pass
    if baseline_children is not None:
        adopted.extend(_cleanup_adopted_runtime_children(baseline_children))
    if _wait_process_group_gone(pgid, 0.1):
        return sorted(set(adopted))

    try:
        os.killpg(pgid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    try:
        process.wait(timeout=PROCESS_GROUP_KILL_GRACE_SECONDS)
    except subprocess.TimeoutExpired:
        pass
    if baseline_children is not None:
        adopted.extend(_cleanup_adopted_runtime_children(baseline_children))
    if not _wait_process_group_gone(pgid, PROCESS_GROUP_KILL_GRACE_SECONDS):
        raise RuntimeError(
            f"heartbeat runtime process group {pgid} survived SIGTERM and SIGKILL"
        )
    return sorted(set(adopted))


def _run_runtime(cmd, *, cwd, runtime_env, prompt, use_stdin, timeout_seconds,
                 terminal_failure_check=None):
    """Run one CLI in its own process group; a timeout cannot leave agent children alive."""
    previous_subreaper = _set_child_subreaper(True)
    baseline_children = _direct_children(os.getpid())
    process = None
    runtime_closed = False
    try:
        process = subprocess.Popen(
            cmd,
            cwd=str(cwd),
            stdin=subprocess.PIPE if use_stdin else None,
            text=True,
            env=runtime_env,
            start_new_session=True,
        )
        started = time.monotonic()
        input_value = prompt if use_stdin else None
        while True:
            remaining = timeout_seconds - (time.monotonic() - started)
            if remaining <= 0:
                adopted = _terminate_process_group(process, baseline_children)
                runtime_closed = True
                raise subprocess.TimeoutExpired(
                    cmd, timeout_seconds,
                    stderr=f"reaped detached runtime children: {adopted}" if adopted else None,
                )
            try:
                process.communicate(
                    input=input_value,
                    timeout=min(RUNTIME_POLL_SECONDS, remaining),
                )
                _reap_exited_adopted_children(baseline_children)
                adopted = _cleanup_adopted_runtime_children(baseline_children)
                runtime_closed = True
                if adopted:
                    raise RuntimeDetachedChildren(
                        f"runtime exited with detached children; reaped pids={adopted}"
                    )
                return process.returncode
            except subprocess.TimeoutExpired:
                # communicate() retains the original input after its first timed wait.
                input_value = None
                terminal = terminal_failure_check() if terminal_failure_check else None
                if terminal:
                    _terminate_process_group(process, baseline_children)
                    runtime_closed = True
                    raise RuntimeRiteTerminal(str(terminal))
    finally:
        try:
            # subprocess.run() used to kill+wait on every exceptional exit. Preserve that
            # fail-closed contract for KeyboardInterrupt, polling failures, and any future
            # exception path: no privileged runtime may outlive the launcher that owns it.
            if process is not None and not runtime_closed:
                _terminate_process_group(process, baseline_children)
        finally:
            _set_child_subreaper(previous_subreaper)


def _terminal_rite_failure(home, dispatch_id, *, runtime_root=None):
    """Describe a matching rite failure only when no protocol repair remains."""
    failed = _rite_manifests(
        home, dispatch_id, statuses=("failed",), runtime_root=runtime_root
    )
    terminal = []
    for path, manifest in failed:
        stage = manifest.get("failed_stage") or "unknown"
        if stage == "final_review_acceptance" \
                and int(manifest.get("final_review_repair_count") or 0) < 1:
            continue
        terminal.append(f"{path.parent.name}:{stage}")
    if not terminal:
        return None
    return "terminal rite failure: " + ", ".join(terminal)


def _runtime_root(home):
    """Mutable output root; absent override preserves the historical install layout."""
    return _identity.runtime_root(Path(home) / "agent.yaml", fallback_root=home)


def _install_event_log(home, runtime_root=None):
    """Tier-0 log owned by the explicit runtime root (legacy: ``--home``)."""
    output = Path(runtime_root) if runtime_root is not None else _runtime_root(home)
    return output / "state" / "events" / "log.jsonl"


def _rite_manifests(home, dispatch_id, statuses=("running",), *, runtime_root=None):
    """Manifestos deste dispatch nos estados pedidos, em ordem estável."""
    found = []
    output = Path(runtime_root) if runtime_root is not None else _runtime_root(home)
    for path in sorted((output / "state" / "rito").glob("*/00_MANIFEST.json")):
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if data.get("dispatch_id") == dispatch_id and data.get("status") in statuses:
            found.append((path, data))
    return found


def _continuation_prompt(dispatch_id, manifests):
    runs = []
    for path, data in manifests:
        stage = next((s.get("name") for s in data.get("stages", [])
                      if s.get("status") in ("running", "failed", "pending")), "unknown")
        runs.append(f"- {path.parent}: status={data.get('status')}; next={stage}")
    return f"""LOCALIZED HEARTBEAT CONTINUATION — binding runtime instruction

The same dispatch {dispatch_id} returned while its rite was non-terminal.
Do NOT rerun Ato 1, shortlist, proposal, grounding, or mint another slug/run directory.
Resume the SAME run with rito.run_rito(..., resume=True); completed sealed stages are reused.
If the manifest failed only because the heartbeat launcher terminalized its active stage,
generic resume is correct. Use repair_final_review=True ONLY for final_review_acceptance.
Run every slow command in FOREGROUND. Do not answer "progressing", "still watching", or wait
for background work: this turn ends only after publication, explicit rite failure, or honest
pauta.silencio. Never enlarge a repair/retry budget.

Runs to resume:
{chr(10).join(runs)}
"""


def _ato1_is_incomplete(eventlog_module, log, dispatch_id):
    """Return true only for a live Ato-1 that has not reached a pauta outcome.

    Claude Code may move a long foreground command to its own background queue and
    end the headless turn.  A dispatch.open proves that Ato-1 actually started; a
    proposta, silencio, or dispatch.failed is terminal for this narrow continuation
    seam and must never be replayed.
    """
    own_types = {
        event.get("type")
        for event in eventlog_module.read(log=log)
        if (event.get("payload") or {}).get("dispatch_id") == dispatch_id
    }
    if "dispatch.open" not in own_types:
        return False
    return not own_types.intersection({
        "pauta.proposta", "pauta.silencio", "dispatch.failed",
    })


def _ato1_continuation_prompt(dispatch_id):
    return f"""LOCALIZED HEARTBEAT ATO-1 CONTINUATION — binding runtime instruction

The same dispatch {dispatch_id} returned before pauta.proposta or pauta.silencio.
Do NOT mint or open another dispatch. Do NOT rerun predispatch, catalogo, shortlist, or
another phase that already has a completed phase receipt for this dispatch. Read the
durable event log, continue only the first missing Ato-1 phase, then re-derive the
authoritative dispatch plan and STOP when a proposta survives. Do not open Ato-2; the
launcher verifies the checkpoint and grants Ato-2 its own budget.

Run every slow command in FOREGROUND. If Claude Code automatically moves a foreground
command to a background task, wait for that exact task with TaskOutput/Monitor until it
is terminal; never end the turn with "I'll resume", "progressing", or "still watching".
This continuation ends only after publication, explicit terminal failure, or honest
pauta.silencio. Never enlarge a repair/retry budget.
"""


def _ato1_checkpoint_prompt(skill_prompt, dispatch_id):
