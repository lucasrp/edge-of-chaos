do not dispatch a producer, and do not create a rito manifest in this invocation. The launcher
will verify the durable outcome and grant Ato-2 a separate budget. Silence is terminal.

{skill_prompt}
"""


def _dispatch_event_types(eventlog_module, log, dispatch_id):
    return {
        event.get("type")
        for event in eventlog_module.read(log=log)
        if (event.get("payload") or {}).get("dispatch_id") == dispatch_id
    }


def _ato2_start_prompt(dispatch_id):
    return f"""HEARTBEAT ATO-2 START — binding runtime instruction

A durable pauta.proposta already survived for dispatch {dispatch_id}. Do NOT rerun Ato-1,
predispatch, catalogo, shortlist, pauta grounding, or propose. Read that exact proposta from the
event log, re-derive the authoritative dispatch plan with tools/_beat.py dispatch-plan, and run
only its declared producer through the shared rite to publication. Keep the same dispatch_id and
required slug_prefix. Run every command and branch in foreground. If Claude Code moves work to
background automatically, block on TaskOutput/Monitor; never end on a progress message.
The turn ends only after publication or explicit terminal rite failure.
"""


def _seconds_between(a, b):
    try:
        return round((dt.datetime.fromisoformat(b) - dt.datetime.fromisoformat(a)).total_seconds(), 3)
    except (TypeError, ValueError):
        return None


def _record_ato1_receipt(eventlog, log, dispatch_id):
    """Coarse Ato-1 timings from immutable events; one receipt per dispatch."""
    events = list(eventlog.read(log=log))
    if any(e.get("type") == "dispatch.phase_receipt"
           and (e.get("payload") or {}).get("dispatch_id") == dispatch_id for e in events):
        return None
    own = [e for e in events if (e.get("payload") or {}).get("dispatch_id") == dispatch_id]
    by_type = {}
    for e in own:
        by_type.setdefault(e.get("type"), e)
    opened = by_type.get("dispatch.open")
    grounded = by_type.get("dispatch.grounding")
    pauta_event = by_type.get("pauta.proposta") or by_type.get("pauta.silencio")
    if not opened:
        return None
    payload = {"dispatch_id": dispatch_id, "schema": "edge.ato1-timing/v1",
               "status": "pauta_terminal" if pauta_event else "incomplete"}
    if grounded:
        payload["open_to_grounding_seconds"] = _seconds_between(opened.get("ts"), grounded.get("ts"))
    if grounded and pauta_event:
        payload["grounding_to_pauta_seconds"] = _seconds_between(grounded.get("ts"), pauta_event.get("ts"))
    if pauta_event:
        payload["ato1_total_seconds"] = _seconds_between(opened.get("ts"), pauta_event.get("ts"))
        payload["pauta_outcome"] = pauta_event.get("type")
    return eventlog.append("dispatch.phase_receipt", "dispatch", payload, log=log)


def _mark_running_rites_failed(home, dispatch_id, reason, *, runtime_root=None):
    """Make interrupted branch manifests terminal; never touch another dispatch."""
    changed = []
    output = Path(runtime_root) if runtime_root is not None else _runtime_root(home)
    for manifest in (output / "state" / "rito").glob("*/00_MANIFEST.json"):
        try:
            data = json.loads(manifest.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if data.get("dispatch_id") != dispatch_id or data.get("status") != "running":
            continue
        now = dt.datetime.now(dt.timezone.utc).isoformat()
        for stage in data.get("stages") or []:
            if stage.get("status") == "running":
                stage["status"] = "failed"
                stage["error"] = reason
                stage["finished_at"] = now
                data["failed_stage"] = stage.get("name")
        data["status"] = "failed"
        data["finished_at"] = now
        data["updated_at"] = now
        tmp = manifest.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        os.replace(tmp, manifest)
        changed.append(str(manifest))
    return changed


def _record_failure(eventlog, log, dispatch_id, *, reason, cli, detail=None,
                    elapsed_seconds=None):
    """Close an unsuccessful invocation in Tier-0 without pretending it published."""
    payload = {
        "dispatch_id": dispatch_id,
        "reason": reason,
        "cli": cli,
    }
    if detail:
        payload["detail"] = str(detail)[:500]
    if elapsed_seconds is not None:
        payload["elapsed_seconds"] = round(float(elapsed_seconds), 3)
    return eventlog.append("dispatch.failed", "dispatch", payload, log=log)


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--home", required=True)
    ap.add_argument("--group", default=None,
                    help="Override the graph group for the cortex door (else identity resolves it)")
    ap.add_argument("--dispatch-id", default=None,
                    help="Stable plan id for an idempotent retry (default: mint one invocation id)")
    ap.add_argument("--cli", default=None, choices=_ALL_CLIS,
                    help="Headless runtime override (default: agent.yaml heartbeat.cli or claude)")
    ap.add_argument("--dry-run", action="store_true", help="Print the command and prompt; do not invoke")
    ap.add_argument(
        "--timeout-seconds", type=int, default=None,
        help="Global hard limit for the complete headless beat (maximum: 1800 seconds)",
    )
    ap.add_argument(
        "--supervised-cortex-broker", action="store_true",
        help="One-shot Codex pilot: use the static read-only Cortex broker; never enables a timer",
    )
    args = ap.parse_args()

    home = Path(os.path.expanduser(args.home)).resolve()
    runtime_root = _runtime_root(home)
    # Onboarding gate (bootstrap path only): refuse until phenotype + grill complete.
    # Legacy installs (agent.yaml, no state/bootstrap.json) are unchanged.
    try:
        import onboarding
        boot = home / "state" / "bootstrap.json"
        install_log = _install_event_log(home, runtime_root)
        if boot.is_file() and not onboarding.is_onboarding_complete(home, log=install_log):
            onboarding.assert_production_allowed(home, log=install_log)
    except RuntimeError as e:
        print(f"edge-heartbeat: {e}", file=sys.stderr)
        sys.exit(2)
    except ImportError:
        pass
    prompt = _beat.load_beat_prompt(home)

    if args.cli == "random":
        cli = _beat.pick_heartbeat_cli()
    elif args.cli:
        cli = args.cli.strip().lower()
    else:
        cli = _beat.heartbeat_cli(home)
    if cli not in _beat.FIXED_HEARTBEAT_CLIS:
        cli = "claude"
    if args.supervised_cortex_broker and cli != "codex":
        print("edge-heartbeat: --supervised-cortex-broker requires --cli codex",
              file=sys.stderr)
        sys.exit(2)

    print(f"edge-heartbeat: cli={cli}", file=sys.stderr)

    mcp_config_path = None
    use_stdin = True
    prompt_file = None
    cmd = None

    if cli in _CLAUDE_FAMILY:
        try:
            claude_bin = _beat.resolve_claude_bin()
        except FileNotFoundError:
            if not args.dry_run:
                raise
            claude_bin = "claude"
        # Slice 6 (F1) — cortex door on lead beat (claude MCP only).
        try:
            mcp_config_path = _beat.ensure_cortex_config(home, group=args.group)
        except Exception as e:  # noqa: BLE001
            print(f"edge-heartbeat: cortex door not registered ({type(e).__name__}: {e}) — "
                  f"the beat runs without mid-turn recall; recall still seeds at wake",
                  file=sys.stderr)
            mcp_config_path = None
        model = cli if cli in ("opus", "fable") else None
        cmd = _beat.build_beat_command(
            claude_bin, mcp_config_path=mcp_config_path, model=model)
        use_stdin = True
    elif cli == "codex":
        try:
            codex_bin = _beat.resolve_codex_bin()
        except FileNotFoundError:
            if not args.dry_run:
                raise
            codex_bin = "codex"
        cmd = _beat.build_codex_beat_command(codex_bin, home)
        use_stdin = True
    else:
        # grok
        try:
            grok_bin = _beat.resolve_grok_bin()
        except FileNotFoundError:
            if not args.dry_run:
                raise
            grok_bin = "grok"
        prompt_dir = runtime_root / "state" / "beat"
        prompt_dir.mkdir(parents=True, exist_ok=True)
        prompt_file = prompt_dir / "last-heartbeat-prompt.md"
        use_stdin = False
        cmd = _beat.build_grok_beat_command(grok_bin, prompt_file, home)

    if args.dry_run and use_stdin and not args.supervised_cortex_broker:
        print(" ".join(cmd))
        print("--- prompt ---")
        print(prompt)
        return

    dispatch_id = args.dispatch_id or _beat.mint_plan_dispatch_id()
    broker_socket = None
    if args.supervised_cortex_broker:
        xdg_runtime_root = os.environ.get("XDG_RUNTIME_DIR")
        if not xdg_runtime_root or not Path(xdg_runtime_root).is_absolute():
            print("edge-heartbeat: supervised broker requires an absolute XDG_RUNTIME_DIR",
                  file=sys.stderr)
            sys.exit(2)
        broker_socket = (
            Path(xdg_runtime_root) / "edge-neo4j-capability-broker" / "broker.sock"
        )
        cmd = codex_capability_command(
            cmd, home=home, socket_path=broker_socket, dispatch_id=dispatch_id,
        )
    # PRE-LAUNCH plan (ADR-0024): no proposta exists before the agent runs the Pauta
    # funnel — producer is explicitly pendente; the trunk re-derives the plan through
    # the same seam (dispatch-plan CLI, require_pauta) before opening Ato-2.
    plan = _beat.dispatch_plan(
        "lead", dispatch_id,
        runtime_command=cmd,
        log=runtime_root / "state" / "events" / "log.jsonl",
        require_pauta=False,
    )
    prompt = _beat.bind_dispatch_plan(prompt, plan)
    prompt = _ato1_checkpoint_prompt(prompt, dispatch_id)
    child_env = _beat.build_beat_env(home)
    child_env["EDGE_DISPATCH_PLAN"] = json.dumps(plan, ensure_ascii=False, sort_keys=True)
    child_env["EDGE_DISPATCH_PLAN_ID"] = dispatch_id
    child_env["EDGE_BEAT_CLI"] = cli

    if args.dry_run and args.supervised_cortex_broker:
        print(" ".join(cmd))
        print("--- supervised broker ---")
        print("manual static broker; one-shot bootstrap; stop in finally; timer unchanged")
        print("--- child environment names ---")
        print("capability added only after broker start; value never rendered")
        print("--- prompt ---")
        print(prompt)
        return

    configured_timeout = None
    try:
        import yaml
        cfg = yaml.safe_load((home / "agent.yaml").read_text()) or {}
        configured_timeout = (cfg.get("heartbeat") or {}).get("timeout_seconds")
    except (OSError, TypeError, ValueError):
        pass
    try:
        timeout_seconds = args.timeout_seconds if args.timeout_seconds is not None \
            else int(configured_timeout or DEFAULT_TIMEOUT_SECONDS)
    except (TypeError, ValueError):
        print("edge-heartbeat: heartbeat.timeout_seconds must be a positive integer",
              file=sys.stderr)
        sys.exit(2)
    if timeout_seconds <= 0:
        print("edge-heartbeat: --timeout-seconds must be positive", file=sys.stderr)
        sys.exit(2)
    if timeout_seconds > MAX_TIMEOUT_SECONDS:
        print(
            f"edge-heartbeat: --timeout-seconds must be <= {MAX_TIMEOUT_SECONDS} "
            "so the launcher terminalizes before the 35-minute systemd service limit",
            file=sys.stderr,
        )
        sys.exit(2)

    if cli == "grok":
        # Rebuild command after plan is bound; write full prompt to disk for --prompt-file.
        prompt_file.write_text(prompt, encoding="utf-8")
        cmd = _beat.build_grok_beat_command(
            cmd[0] if cmd else _beat.resolve_grok_bin(), prompt_file, home)
        plan = {**plan, "runtime_command": cmd}
        if args.dry_run:
            print(" ".join(cmd))
            print("--- prompt-file ---", prompt_file)
            print(prompt[:2000])
            return

    import eventlog
    log = runtime_root / "state" / "events" / "log.jsonl"
    with _beat.heartbeat_lock(home, runtime_root=runtime_root):
        from contextlib import nullcontext
        broker_context = supervised_broker_lease(
            home=home, dispatch_id=dispatch_id, base_env=child_env,
        ) if args.supervised_cortex_broker else nullcontext((child_env, None))
        try:
            with broker_context as (runtime_env, _broker_limits):
                before_count = len(eventlog.corpus_at(log=log))
                budget = _HeartbeatBudget(timeout_seconds)
                started = budget.started
                try:
                    current_prompt = prompt
                    act = "ato1"
                    continuations = {"ato1": 0, "ato2": 0}
                    while True:
                        remaining = budget.remaining()
                        if remaining <= 0:
                            raise subprocess.TimeoutExpired(cmd, timeout_seconds)
                        rc = _run_runtime(
                            cmd,
                            cwd=home,
                            runtime_env=runtime_env,
                            prompt=current_prompt,
                            use_stdin=use_stdin,
                            timeout_seconds=remaining,
                            terminal_failure_check=lambda: _terminal_rite_failure(
                                home, dispatch_id, runtime_root=runtime_root
                            ),
                        )
                        running = _rite_manifests(
                            home, dispatch_id, runtime_root=runtime_root
                        )
                        ato1_incomplete = _ato1_is_incomplete(eventlog, log, dispatch_id)
                        own_types = _dispatch_event_types(eventlog, log, dispatch_id)
                        if rc != 0:
                            break
                        if act == "ato1" and "pauta.proposta" in own_types:
                            eventlog.append("dispatch.checkpointed", "dispatch", {
                                "dispatch_id": dispatch_id,
                                "checkpoint": "ato1_completed",
                                "next": "ato2",
                            }, log=log)
                            act = "ato2"
                            current_prompt = _ato2_start_prompt(dispatch_id)
                            continue
                        if act == "ato1" and "pauta.silencio" in own_types:
                            break
                        needs_continuation = bool(running) if act == "ato2" else ato1_incomplete
                        if (not needs_continuation
                                or continuations[act] >= MAX_LOCAL_CONTINUATIONS):
                            break
                        continuations[act] += 1
                        reason = "rite_nonterminal_on_runtime_exit" if act == "ato2" \
                            else "ato1_nonterminal_on_runtime_exit"
                        eventlog.append("dispatch.continued", "dispatch", {
                            "dispatch_id": dispatch_id,
                            "reason": reason,
                            "act": act,
                            "continuation": continuations[act],
                            "run_dirs": [str(path.parent) for path, _ in running],
                        }, log=log)
                        current_prompt = _continuation_prompt(dispatch_id, running) \
                            if act == "ato2" else _ato1_continuation_prompt(dispatch_id)
                except subprocess.TimeoutExpired:
                    _mark_running_rites_failed(
                        home, dispatch_id, "heartbeat_timeout", runtime_root=runtime_root
                    )
                    _record_failure(eventlog, log, dispatch_id, reason="timeout", cli=cli,
                                    detail=(f"global heartbeat limit {timeout_seconds}s "
                                            f"exceeded during {act}"),
                                    elapsed_seconds=time.monotonic() - started)
                    print(f"edge-heartbeat: global timeout after {timeout_seconds}s "
                          f"during {act}; "
                          "dispatch.failed recorded", file=sys.stderr)
                    sys.exit(124)
                except RuntimeRiteTerminal as exc:
                    _mark_running_rites_failed(
                        home, dispatch_id, "heartbeat_rite_terminal",
                        runtime_root=runtime_root,
                    )
                    _record_failure(
                        eventlog, log, dispatch_id, reason="rite_terminal", cli=cli,
                        detail=str(exc), elapsed_seconds=time.monotonic() - started,
                    )
                    print(
                        f"edge-heartbeat: {exc}; dispatch.failed recorded",
                        file=sys.stderr,
                    )
                    sys.exit(1)
                except RuntimeDetachedChildren as exc:
                    _mark_running_rites_failed(
                        home, dispatch_id, "heartbeat_detached_children",
                        runtime_root=runtime_root,
                    )
                    _record_failure(
                        eventlog, log, dispatch_id, reason="detached_children", cli=cli,
                        detail=str(exc), elapsed_seconds=time.monotonic() - started,
                    )
                    print(
                        f"edge-heartbeat: {exc}; dispatch.failed recorded",
                        file=sys.stderr,
                    )
                    sys.exit(1)
                except KeyboardInterrupt:
                    _mark_running_rites_failed(
                        home, dispatch_id, "heartbeat_interrupted", runtime_root=runtime_root
                    )
                    _record_failure(eventlog, log, dispatch_id, reason="interrupted", cli=cli,
                                    elapsed_seconds=time.monotonic() - started)
                    print("edge-heartbeat: interrupted; dispatch.failed recorded", file=sys.stderr)
                    sys.exit(130)
                if rc != 0:
                    _mark_running_rites_failed(
                        home, dispatch_id, f"heartbeat_runtime_exit_{rc}",
                        runtime_root=runtime_root,
                    )
                    _record_failure(eventlog, log, dispatch_id, reason="runtime_nonzero", cli=cli,
                                    detail=f"exit code {rc}",
                                    elapsed_seconds=time.monotonic() - started)
                    sys.exit(rc)
        except RuntimeError as exc:
            _record_failure(eventlog, log, dispatch_id, reason="broker_preflight", cli=cli,
                            detail=str(exc))
            print(f"edge-heartbeat: supervised broker failed closed ({exc})", file=sys.stderr)
            sys.exit(70)

        _record_ato1_receipt(eventlog, log, dispatch_id)

        # Post-gate carries the dente: artefatos require a live pauta.proposta whose
        # forma matches; a logged pauta.silencio is the honest no-produce (never punished).
        gaps = _beat.assert_beat_produced(log, before_count, dispatch_id=dispatch_id)
    if gaps:
        _mark_running_rites_failed(home, dispatch_id, "heartbeat_post_gate_failed")
        _record_failure(eventlog, log, dispatch_id, reason="post_gate", cli=cli,
                        detail="; ".join(gaps))
        for gap in gaps:
            print(f"edge-heartbeat: beat exited 0 but produced no corpus progress: {gap}",
                  file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
