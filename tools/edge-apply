#!/usr/bin/env python3
"""edge-apply — instala a partir do agent.yaml (Fase 0 do v0).

Faz: layout em EDGE_HOME, semeia threads/ das initial_threads, coloca o blog server,
renderiza o Caddyfile pro domínio, e verifica/relata as credenciais (routers + fontes).
Não bloqueia se faltar credencial — relata (substrate-check visível no install).
"""
import argparse
import os
import re
import shutil
import subprocess
import sys
from datetime import date
from pathlib import Path

import yaml

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(Path(__file__).resolve().parent))  # tools/ para importar _llm
import _llm


def slug(s: str) -> str:
    s = s.lower().strip()
    s = re.sub(r"[^\w\s-]", "", s)
    return re.sub(r"[\s_]+", "-", s)


def seed_threads(home: Path, cfg: dict) -> None:
    tdir = home / "threads"
    tdir.mkdir(parents=True, exist_ok=True)
    today = date.today().isoformat()
    owner = cfg.get("codename") or cfg.get("name") or "ed"
    for th in cfg.get("initial_threads") or []:
        title = th["title"]
        sl = slug(title)
        (tdir / f"{sl}.md").write_text(
            f"---\nid: {sl}\ntitle: {title}\nstatus: active\n"
            f"owner: {owner}\ncreated: {today}\nresurface: {today}\n---\n"
            f"{th.get('intent', '')}\n"
        )


def render_caddyfile(home: Path, yaml_path: str) -> None:
    subprocess.run(
        [sys.executable, str(REPO / "tools" / "edge-render"),
         "--yaml", yaml_path,
         "--template", str(REPO / "templates" / "Caddyfile.tpl"),
         "--out", str(home / "Caddyfile")],
        check=True,
    )


def _read_secret(home: Path, ref: str):
    # ref = "<file>:<VAR>"; secrets vivem em <home>/secrets/<file>
    fn, _, var = ref.partition(":")
    path = home / "secrets" / fn
    if not path.exists():
        return None
    for line in path.read_text().splitlines():
        line = line.strip()
        if line.startswith("export "):
            line = line[len("export "):]
        if line.startswith(var + "="):
            return line.split("=", 1)[1].strip().strip('"').strip("'") or None
    return None


def verify_credentials(home: Path, cfg: dict) -> list:
    """Testa o ADAPTER no apply: probe real por router quando a key existe."""
    rows = []
    for name, r in (cfg.get("routers") or {}).items():
        key = _read_secret(home, r.get("secret_ref", "")) if r.get("secret_ref") else None
        if not key:
            rows.append((f"router:{name} ({r.get('provider')})", "FALTA (sem key)", False))
            continue
        try:
            model = r.get("model", "")
            kind = "embedding" if ("embed" in name.lower() or "embed" in model.lower()) else "chat"
            res = _llm.probe(_llm.make_client(r, key), model, kind)
            tag = f"router:{name} ({r.get('provider')}/{r.get('model')})"
            rows.append((tag, f"OK — {res['detail']}", True) if res["ok"]
                        else (tag, f"FALHA {res['status']} — {res['detail']}", False))
        except Exception as e:
            rows.append((f"router:{name} ({r.get('provider')})", f"ERRO adapter: {str(e)[:80]}", False))
    for s in cfg.get("sources") or []:
        if s.get("kind") == "api":
            key = _read_secret(home, s.get("secret_ref", ""))
            rows.append((f"source:{s['name']} (api)", "OK key presente" if key else "FALTA (sem key)", bool(key)))
        else:
            rows.append((f"source:{s['name']} (cli {s.get('command')})", "cli — verificar em runtime", None))
    return rows


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--yaml", required=True)
    ap.add_argument("--home")
    args = ap.parse_args()

    cfg = yaml.safe_load(Path(args.yaml).read_text()) or {}
    home = Path(os.path.expanduser(args.home or cfg.get("edge_home", "~/edge-next/")))

    for d in ("blog/entries", "state", "memory", "threads", "secrets"):
        (home / d).mkdir(parents=True, exist_ok=True)

    seed_threads(home, cfg)
    shutil.copy(REPO / "blog" / "server.py", home / "blog" / "server.py")
    if (REPO / "blog" / "static").exists():
        shutil.copytree(REPO / "blog" / "static", home / "blog" / "static", dirs_exist_ok=True)
    if (REPO / "skills").exists():
        shutil.copytree(REPO / "skills", home / "skills", dirs_exist_ok=True)
    render_caddyfile(home, args.yaml)

    mem = home / "memory" / "MEMORY.md"
    if not mem.exists():
        mem.write_text("# MEMORY\n")

    print(f"apply: instalado em {home}")
    print("credenciais (adapter testado no apply):")
    missing = False
    for label, status, ok in verify_credentials(home, cfg):
        print(f"  - {label}: {status}")
        if ok is False:
            missing = True
    if missing:
        print("aviso: há credenciais ausentes/com falha — corrija antes do heartbeat real")
    sys.exit(0)


if __name__ == "__main__":
    main()
