#!/usr/bin/env python3
"""edge-apply — instala a partir do agent.yaml (Fase 0 do v0).

Faz: layout em EDGE_HOME, coloca o blog server,
renderiza o Caddyfile pro domínio, e verifica/relata as credenciais (routers + fontes).
Não bloqueia se faltar credencial — relata (substrate-check visível no install).
"""
import argparse
import os
import subprocess
import sys
from pathlib import Path

import yaml

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(Path(__file__).resolve().parent))  # tools/ para importar _llm
import _llm
import _claude_provision
import _provision
import _validate


def render_caddyfile(home: Path, yaml_path: str) -> None:
    subprocess.run(
        [sys.executable, str(REPO / "tools" / "edge-render"),
         "--yaml", yaml_path,
         "--template", str(REPO / "templates" / "Caddyfile.tpl"),
         "--out", str(home / "Caddyfile")],
        check=True,
    )


def resolve_env_dir(home: Path, cfg: dict) -> Path:
    """Where this install's secrets live (CONTRACT C4): agent.yaml `env_dir` → <home>/secrets/
    (the default when the field is unset, so it works without it). The genotype declares WHERE
    secrets live, never HOW they arrive (delivery is the operator's channel).
    # TODO(agent.yaml): declare env_dir — agent.yaml is operator-dirty, so the field is deferred;
    #   this resolver already honors it the moment it is added, defaulting to <home>/secrets/."""
    raw = cfg.get("env_dir")
    return Path(os.path.expanduser(str(raw))) if raw else home / "secrets"


def _read_secret(home: Path, ref: str, env_dir: Path = None):
    # ref = "<file>:<VAR>"; secrets vivem em env_dir (agent.yaml env_dir → <home>/secrets/, C4)
    fn, _, var = ref.partition(":")
    if not fn or not var:                      # ref vazio/sem ":" → fonte keyless, não é o dir secrets/
        return None
    base = env_dir if env_dir is not None else home / "secrets"
    path = base / fn
    if not path.exists() or path.is_dir():
        return None
    for line in path.read_text().splitlines():
        line = line.strip()
        if line.startswith("export "):
            line = line[len("export "):]
        if line.startswith(var + "="):
            return line.split("=", 1)[1].strip().strip('"').strip("'") or None
    return None


def required_secret_refs(cfg: dict) -> list:
    """The secret_refs the install REQUIRES: every router + every api source declaring a secret_ref.
    Keyless api sources (hn/arxiv) and cli sources are not required (C4)."""
    refs = []
    for r in (cfg.get("routers") or {}).values():
        if r.get("secret_ref"):
            refs.append(r["secret_ref"])
    for s in cfg.get("sources") or []:
        if s.get("kind") == "api" and s.get("secret_ref"):
            refs.append(s["secret_ref"])
    return refs


def verify_required_secrets(home: Path, cfg: dict, env_dir: Path) -> None:
    """Install posture (CONTRACT C4): every required secret_ref MUST resolve in env_dir, or FAIL
    LOUD naming each missing key. The genotype ships no default value and no delivery mechanism —
    the operator delivers keys into env_dir; the installer only verifies + fails loud."""
    missing = [ref for ref in required_secret_refs(cfg) if not _read_secret(home, ref, env_dir)]
    if missing:
        raise RuntimeError(
            "missing required credential(s) in env_dir " + str(env_dir) + ": "
            + ", ".join(missing) + " — deliver them before install (the genotype ships no default).")


def verify_credentials(home: Path, cfg: dict, env_dir: Path = None) -> list:
    """Testa o ADAPTER no apply: probe real por router quando a key existe. Resolve secret_refs
    contra env_dir (agent.yaml → <home>/secrets/, C4)."""
    rows = []
    for name, r in (cfg.get("routers") or {}).items():
        key = _read_secret(home, r.get("secret_ref", ""), env_dir) if r.get("secret_ref") else None
        if not key:
            rows.append((f"router:{name} ({r.get('provider')})", "FALTA (sem key)", False))
            continue
        try:
            model = r.get("model", "")
            kind = "embedding" if ("embed" in name.lower() or "embed" in model.lower()) else "chat"
            res = _llm.probe(_llm.make_client(r, key), model, kind)
            tag = f"router:{name} ({r.get('provider')}/{r.get('model')})"
            rows.append((tag, f"OK — {res['detail']}", True) if res["ok"]
                        else (tag, f"FALHA {res['status']} — {res['detail']}", False))
        except Exception as e:
            rows.append((f"router:{name} ({r.get('provider')})", f"ERRO adapter: {str(e)[:80]}", False))
    for s in cfg.get("sources") or []:
        if s.get("kind") == "api":
            ref = s.get("secret_ref")
            if not ref:                        # api keyless (hn/arxiv): pública, não precisa de key
                rows.append((f"source:{s['name']} (api)", "OK — keyless (sem secret_ref)", True))
                continue
            key = _read_secret(home, ref, env_dir)
            rows.append((f"source:{s['name']} (api)", "OK key presente" if key else "FALTA (sem key)", bool(key)))
        else:
            rows.append((f"source:{s['name']} (cli {s.get('command')})", "cli — verificar em runtime", None))
    return rows


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--yaml", required=True)
    ap.add_argument("--home")
    ap.add_argument("--claude-home",
                    help="target ~/.claude dir (default: real ~/.claude). "
                         "Tests/smoke-runs MUST point this at a tmp dir.")
    ap.add_argument("--provision-runtime", action="store_true",
                    help="provision the mandatory graph runtime: venv (#20), per-host Neo4j via "
                         "Docker (#18), and the systemd heartbeat timer (#19). Fails loud on a "
                         "missing prerequisite (ADR-0011). Off by default (files-only apply).")
    ap.add_argument("--validate", action="store_true",
                    help="validate the install only: report each substrate check and exit nonzero "
                         "if broken (no provisioning, no file placement).")
    args = ap.parse_args()

    cfg = yaml.safe_load(Path(args.yaml).read_text()) or {}
    home = Path(os.path.expanduser(args.home or cfg.get("edge_home") or "~/edge/"))
    env_dir = resolve_env_dir(home, cfg)               # agent.yaml env_dir → <home>/secrets/ (C4)
    claude_home = Path(os.path.expanduser(args.claude_home)) if args.claude_home \
        else Path.home() / ".claude"

    if args.validate:
        report, healthy = _validate.format_report(_validate.validate_install(
            home, cfg, env_dir, provisioned=True, repo_tools=REPO / "tools",
            agent_yaml=Path(args.yaml)))      # identity validates the APPLIED config, not the default
        print(report)
        sys.exit(0 if healthy else 1)

    for d in ("blog/entries", "state", "memory", "threads", "secrets"):
        (home / d).mkdir(parents=True, exist_ok=True)

    _provision.place_file(REPO / "blog" / "server.py", home / "blog" / "server.py")
    if (REPO / "blog" / "static").exists():
        _provision.place_tree(REPO / "blog" / "static", home / "blog" / "static")
    if (REPO / "skills").exists():
        _provision.place_tree(REPO / "skills", home / "skills")
    render_caddyfile(home, args.yaml)

    mem = home / "memory" / "MEMORY.md"
    if not mem.exists():
        mem.write_text("# MEMORY\n")

    print(f"apply: instalado em {home}")
    print(f"apply: provisionando ~/.claude em {claude_home}")
    for row in _claude_provision.provision_claude(cfg, REPO, claude_home):
        print(f"  - {row}")

    if args.provision_runtime:
        print("apply: provisionando o runtime (graph obrigatório — ADR-0011)")
        verify_required_secrets(home, cfg, env_dir)    # C4: fail loud per missing required key
        print(f"  - secrets verificados em {env_dir}")
        _provision.build_venv(home, REPO / "requirements.txt")
        print(f"  - venv → {home / '.venv'} (deps de requirements.txt)")
        secret = _provision.provision_neo4j(home, env_dir)
        print(f"  - neo4j (docker, {_provision.NEO4J_IMAGE}) → senha em {secret}")
        _provision.install_heartbeat(cfg, home)
        print(f"  - heartbeat timer (systemd --user, OnUnitActiveSec="
              f"{cfg.get('heartbeat_interval', '3h')}) instalado + enable --now")
        _provision.check_headless_auth()
        print("  - headless-auth: claude -p autentica sem TTY")

    print("credenciais (adapter testado no apply):")
    missing = False
    for label, status, ok in verify_credentials(home, cfg, env_dir):
        print(f"  - {label}: {status}")
        if ok is False:
            missing = True
    if missing:
        print("aviso: há credenciais ausentes/com falha — corrija antes do heartbeat real")

    report, healthy = _validate.format_report(_validate.validate_install(
        home, cfg, env_dir, provisioned=args.provision_runtime, repo_tools=REPO / "tools",
        agent_yaml=Path(args.yaml)))           # identity validates the APPLIED config, not the default
    print(report)
    if args.provision_runtime and not healthy:
        # AUTHORITATIVE: a PROVISIONED install that comes up unhealthy must NOT finish claiming
        # success (today it exits 0 regardless). Best-effort: don't leave the heartbeat timer enabled
        # on a broken install (it would dispatch a lobotomized beat); at minimum exit nonzero so the
        # operator/automation sees the failure. (Files-only apply keeps its "report, don't block"
        # contract — it legitimately runs before secrets are delivered.)
        try:
            subprocess.run(["systemctl", "--user", "disable", "--now", "edge-heartbeat.timer"],
                           check=False)
        except Exception:
            pass
        print("apply: install UNHEALTHY — heartbeat timer disabled (best-effort), see [XX] above")
        sys.exit(1)
    sys.exit(0)


if __name__ == "__main__":
    main()
